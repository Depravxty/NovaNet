{
  "manifest_version": 3,
  "name": "N\u00d8VA Net",
  "version": "0.4.0",
  "description": "Shows Leetify stats directly on Steam profile pages.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://steamcommunity.com/profiles/*",
    "https://steamcommunity.com/id/*",
    "https://api-public.cs-prod.leetify.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://steamcommunity.com/profiles/*",
        "https://steamcommunity.com/id/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/leetify-badge.png"],
      "matches": ["https://steamcommunity.com/*"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "N\u00d8VA Net"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
